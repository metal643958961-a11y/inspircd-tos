[zh-cn]
name = "InspIRCd"
auth = "316z666"
descript = "为 NAS 本机 IRC 客户端提供频道聊天和私聊。"
important = "首次启动前在项目 .env 设置 64 位随机小写十六进制 IRC_SECRET，仅监听本机 16667，不保存聊天记录。"
release_note = "TOS x86_64 4.12.1.2: category, persistence and first-start initialization corrections."

[zh-hk]
name = "InspIRCd"
auth = "316z666"
descript = "為 NAS 本機 IRC 用戶端提供頻道聊天和私聊。"
important = "請先在專案 .env 設定 64 位隨機小寫十六進位 IRC_SECRET，僅監聽本機 16667，不保存聊天記錄。"
release_note = "TOS x86_64 4.12.1.2: category, persistence and first-start initialization corrections."

[en-us]
name = "InspIRCd"
auth = "316z666"
descript = "Run a private local IRC service with channels and direct messages."
important = "Set IRC_SECRET in the project .env to 64 random lowercase hex characters. Local port 16667; no chat history."
release_note = "TOS x86_64 4.12.1.2: category, persistence and first-start initialization corrections."

